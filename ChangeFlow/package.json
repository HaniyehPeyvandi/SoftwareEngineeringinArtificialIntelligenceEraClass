{
  "name": "changeflow",
  "version": "0.1.0",
  "private": true,
  "description": "Academic Change Request Management backend MVP",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=10.9.9 <11"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/init-db.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "jose": "6.2.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
