# Copy to .env for local use; npm database/dev scripts load it from the project root.
# Local demo only. Keep .env private and never include generated demo credentials here.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/changeflow.sqlite

# Required: generate a private random value of at least 32 bytes, base64 encoded.
# Deliberately empty; never commit a real signing secret or generated passwords.
# Set a fresh value before database/server commands; see specs/001-change-request-workflow/quickstart.md.
JWT_SECRET_BASE64=
