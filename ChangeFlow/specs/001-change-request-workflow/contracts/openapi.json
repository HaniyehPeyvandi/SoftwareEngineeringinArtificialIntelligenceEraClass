{
  "openapi": "3.1.1",
  "info": {
    "title": "ChangeFlow MVP API",
    "version": "1.0.0",
    "description": "Planning contract only. See README.md for current-role lookup, transaction boundaries, error ordering, text normalization/counting, and visibility. Fields use camelCase; version is specification Version. All critical integration tests assert HTTP responses and actual SQLite state."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000/api",
      "description": "Local academic demo"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
