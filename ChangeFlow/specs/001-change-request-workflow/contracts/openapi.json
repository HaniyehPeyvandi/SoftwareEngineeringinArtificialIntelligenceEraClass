  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256 only; iss changeflow; aud changeflow-api; UUID sub; iat and exp required, lifetime 900s. Current roles and active user are reloaded in SQLite on every operation; token roles never authorize."
      }
    },
    "schemas": {
      "CreateBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "reason"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 200 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 200,
            "x-counting-unit": "Unicode code points"
          },
          "description": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 5000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 5000,
            "x-counting-unit": "Unicode code points"
          },
          "reason": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 2000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 2000,
            "x-counting-unit": "Unicode code points"
          }
        }
      },
      "EditBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "reason",
          "version"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 200 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 200,
            "x-counting-unit": "Unicode code points"
          },
          "description": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 5000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 5000,
            "x-counting-unit": "Unicode code points"
          },
          "reason": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 2000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 2000,
            "x-counting-unit": "Unicode code points"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Expected current integer Version. Advances once per accepted edit or transition."
          }
        }
      },
      "VersionBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Expected current integer Version. Advances once per accepted edit or transition."
          }
        }
      },
      "ReturnBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "comment"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Expected current integer Version. Advances once per accepted edit or transition."
          },
          "comment": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 2000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 2000,
            "x-counting-unit": "Unicode code points"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Exact local demo username."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "description": "Raw password; do not trim or normalize."
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "const": 900
          }
        }
      },
      "ChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "reason",
          "requesterId",
          "status",
          "version",
          "reviewerComment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 200 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 200,
            "x-counting-unit": "Unicode code points"
          },
          "description": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 5000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 5000,
            "x-counting-unit": "Unicode code points"
          },
          "reason": {
            "type": "string",
            "description": "Required non-whitespace valid Unicode text; maximum 2000 code points after surrounding ECMAScript trim. Original text is preserved.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 2000,
            "x-counting-unit": "Unicode code points"
          },
          "requesterId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "PendingReview",
              "ChangesRequested",
              "Approved"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Expected current integer Version. Advances once per accepted edit or transition."
          },
          "reviewerComment": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest return comment, or null before first return. Required on RequestChanges; retained on edit, Submit and Approve; replaced by next successful RequestChanges.",
            "x-trimmed-min-codepoints": 1,
            "x-trimmed-max-codepoints": 2000,
            "x-counting-unit": "Unicode code points"
          }
        }
      },
      "ChangeRequestList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeRequest"
            },
            "description": "Authorized items, sorted by ID ascending; empty array when none."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "UNAUTHENTICATED",
                  "INVALID_CREDENTIALS",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "VERSION_CONFLICT",
                  "INVALID_STATUS",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_FAILED",
                  "STORAGE_BUSY",
                  "STORAGE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "reason"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
